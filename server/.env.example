NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/campusride
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
APP_ORIGIN=http://localhost:5173
# Optional signup restriction; comma-separated. This validates the domain only, NOT email ownership.
ALLOWED_EMAIL_DOMAINS=
# Set to 1 behind Render's single reverse proxy. Leave 0 locally.
TRUST_PROXY=0
